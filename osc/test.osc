#import chopped_standard.osc
import standard.osc
scenario top:
    pathy: path                      # A path in the map
    pathy.min_lanes(2)         # Path should have at least two lanes

    ego_vehicle: vehicle
    npc: person               # The other car

    ego_start_speed: speed = 50kph
    do serial:
        get_ahead: parallel(duration: 15s):
            ego_vehicle.drive() with:

                position([10m..20m], ahead_of: npc, at: start)
                lateral(2m, side: left, side_of: npc, at: start)
                speed(ego_start_speed)
